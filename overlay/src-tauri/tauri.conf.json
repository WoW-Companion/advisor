{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoW Companion",
  "version": "0.1.0",
  "identifier": "app.wowcompanion.overlay",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WoW Companion",
        "width": 340,
        "height": 480,
        "minWidth": 280,
        "minHeight": 200,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/wowc-advisor"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
